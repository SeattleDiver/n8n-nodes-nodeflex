{
  "name": "n8n-nodes-privateworkflow",
  "version": "0.1.0",
  "description": "Execute Private Workflow",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/seattlediver/n8n-cloudworkflow#readme",
  "author": "undefined",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seattlediver/n8n-cloudworkflow.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PrivateWorkflowApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PrivateWorkflowTrigger/PrivateWorkflowTrigger.node.ts",
      "dist/nodes/PrivateWorkflow/PrivateWorkflow.node.ts",
      "dist/nodes/RespondToPrivateWorkflow/RespondToPrivateWorkflow.node.ts"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/parser": "~8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "n8n-workflow": "^1.113.0"
  },
  "bugs": {
    "url": "https://github.com/seattlediver/n8n-cloudworkflow/issues"
  },
  "dependencies": {
    "n8n-core": "^1.115.0"
  }
}
